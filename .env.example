# LINE Bot 基本設定
LINE_CHANNEL_SECRET="your_line_channel_secret_here"
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here"

# OpenAI GPT-4
OPENAI_API_KEY="your_openai_api_key_here"  # 給 GPT-4 用於圖片/音訊/多模態

# DeepSeek
DEEPSEEK_API_KEY="your_deepseek_api_key_here"  # 給 DeepSeek 用於文字訊息
# LIFF 設定
VITE_LIFF_ID="your_liff_id_here"  # LIFF ID

# PostgreSQL 資料庫設定 (Docker Compose)
POSTGRES_USER="healmate"
POSTGRES_PASSWORD="healmate_pass"
POSTGRES_DB="healmate_db"
POSTGRES_PORT="5432" # 預設為 5432

# GraphRAG 設定
GRAPHRAG_API_BASE="https://api.openai.com/v1"  # 或 DeepSeek API
GRAPHRAG_MODEL="gpt-4"  # 或 deepseek-chat
GRAPHRAG_EMBEDDING_MODEL="text-embedding-ada-002"  # embedding 模型

# LLM 參數
GRAPHRAG_LLM_MAX_TOKENS="4000"                 # LLM 最大輸出 tokens
GRAPHRAG_LLM_TEMPERATURE="0.7"                 # LLM 創造性 (0-1)
GRAPHRAG_LLM_TOP_P="1.0"                       # LLM 核心採樣
GRAPHRAG_LLM_TIMEOUT="180"                     # LLM 請求超時 (秒)
GRAPHRAG_LLM_MAX_RETRIES="3"                   # LLM 最大重試次數

# Embedding 參數
GRAPHRAG_EMBEDDING_BATCH_SIZE="16"             # 嵌入批次大小
GRAPHRAG_EMBEDDING_MAX_TOKENS="8191"           # 嵌入最大 tokens
GRAPHRAG_EMBEDDING_TIMEOUT="180"               # 嵌入請求超時 (秒)
GRAPHRAG_EMBEDDING_MAX_RETRIES="3"             # 嵌入最大重試次數
GRAPHRAG_EMBEDDING_CONCURRENT="25"             # 嵌入並發請求數

# 文本處理參數
GRAPHRAG_CHUNK_SIZE="300"                      # 文本塊大小
GRAPHRAG_CHUNK_OVERLAP="100"                   # 文本塊重疊大小
GRAPHRAG_TEXT_EMBEDDING_BATCH_SIZE="16"        # 文本嵌入批次大小
GRAPHRAG_TEXT_EMBEDDING_MAX_TOKENS="8191"      # 文本嵌入最大 tokens

# 實體提取參數
GRAPHRAG_ENTITY_MAX_GLEANINGS="1"              # 實體提取最大清理次數

# 關係提取參數
GRAPHRAG_RELATIONSHIP_MAX_GLEANINGS="1"        # 關係提取最大清理次數

# 社群偵測參數
GRAPHRAG_COMMUNITY_MAX_CLUSTER_SIZE="10"       # 社群最大集群大小

# 全域搜尋參數
GRAPHRAG_GLOBAL_TEMPERATURE="0.0"              # 全域搜尋溫度
GRAPHRAG_GLOBAL_TOP_P="1.0"                    # 全域搜尋核心採樣
GRAPHRAG_GLOBAL_MAX_TOKENS="12000"             # 全域搜尋最大 tokens
GRAPHRAG_GLOBAL_CONCURRENCY="32"               # 全域搜尋並發數

# 本地搜尋參數
GRAPHRAG_LOCAL_TEMPERATURE="0.0"               # 本地搜尋溫度
GRAPHRAG_LOCAL_TOP_P="1.0"                     # 本地搜尋核心採樣
GRAPHRAG_LOCAL_MAX_TOKENS="12000"              # 本地搜尋最大 tokens
GRAPHRAG_LOCAL_TEXT_UNIT_PROP="0.5"            # 本地搜尋文本單元比例
GRAPHRAG_LOCAL_COMMUNITY_PROP="0.1"            # 本地搜尋社群比例
GRAPHRAG_LOCAL_TOP_K_ENTITIES="10"             # 本地搜尋頂級實體數
GRAPHRAG_LOCAL_TOP_K_RELATIONSHIPS="10"        # 本地搜尋頂級關係數